          <mxGeometry x="100" y="40" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ECS Fargate (AZ-a) -->
        <mxCell id="ecs-a" value="Amazon ECS (Fargate)&#10;Mattermostコンテナ" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;fontFamily=M PLUS 1;" vertex="1" parent="priv-a">
          <mxGeometry x="100" y="40" width="78" height="78" as="geometry" />
        </mxCell>
        <!-- Aurora (AZ-a Writer) -->
        <mxCell id="aurora-a" value="Aurora Serverless v2&#10;(PostgreSQL) Writer" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;fontFamily=M PLUS 1;" vertex="1" parent="priv-a">
          <mxGeometry x="100" y="200" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ECS Fargate (AZ-c) -->
        <mxCell id="ecs-c" value="Amazon ECS (Fargate)&#10;Mattermost (冗長)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;fontFamily=M PLUS 1;" vertex="1" parent="priv-c">
          <mxGeometry x="100" y="40" width="78" height="78" as="geometry" />
        </mxCell>
        <!-- Aurora (AZ-c Reader) -->
        <mxCell id="aurora-c" value="Aurora Serverless v2&#10;(PostgreSQL) Reader" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.aurora;fontFamily=M PLUS 1;" vertex="1" parent="priv-c">
          <mxGeometry x="100" y="200" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- S3 (リージョン内、VPC外) -->
        <mxCell id="s3" value="Amazon S3&#10;ファイルストレージ（任意）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;fontFamily=M PLUS 1;" vertex="1" parent="region">
          <mxGeometry x="720" y="150" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Secrets Manager -->
        <mxCell id="secrets" value="AWS Secrets Manager&#10;DB認証情報 / Webhookトークン" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;fontFamily=M PLUS 1;" vertex="1" parent="region">
          <mxGeometry x="900" y="150" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- API Gateway -->
        <mxCell id="apigw" value="Amazon API Gateway&#10;(REST API) Webhook受け口" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;fontFamily=M PLUS 1;" vertex="1" parent="region">
          <mxGeometry x="720" y="430" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Lambda -->
        <mxCell id="lambda" value="AWS Lambda&#10;翻訳処理関数" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;fontFamily=M PLUS 1;" vertex="1" parent="region">
          <mxGeometry x="900" y="430" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Translate -->
        <mxCell id="translate" value="Amazon Translate&#10;日英韓 機械翻訳 (auto判定)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.translate;fontFamily=M PLUS 1;" vertex="1" parent="region">
          <mxGeometry x="900" y="620" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- Comprehend -->
        <mxCell id="comprehend" value="Amazon Comprehend&#10;言語自動判定（内部利用）" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=10;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.comprehend;fontFamily=M PLUS 1;" vertex="1" parent="region">
          <mxGeometry x="900" y="800" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ===== エッジ（データフロー） ===== -->
        <!-- 1. users -> internet -->
        <mxCell id="e1" value="①" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=12;" edge="1" parent="1" source="users" target="internet">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- internet -> ALB(a) HTTPS -->
        <mxCell id="e2" value="① HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;" edge="1" parent="1" source="internet" target="alb-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ALB(a) -> ECS(a) -->
        <mxCell id="e3" value="① ルーティング" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;" edge="1" parent="1" source="alb-a" target="ecs-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- ALB(c) -> ECS(c) -->
        <mxCell id="e3b" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#232F3E;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;dashed=1;" edge="1" parent="1" source="alb-c" target="ecs-c">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 2. ECS(a) <-> Aurora(a) -->
        <mxCell id="e4" value="② 読み書き" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;startArrow=block;endArrow=block;strokeColor=#C925D1;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;" edge="1" parent="1" source="ecs-a" target="aurora-a">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 3. ECS(a) -> S3 -->
        <mxCell id="e5" value="③ ファイル保存（任意）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#7AA116;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;dashed=1;" edge="1" parent="1" source="ecs-a" target="s3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 4. ECS(a) Outgoing Webhook -> API Gateway -->
        <mxCell id="e6" value="④ Outgoing Webhook" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#E7157B;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;" edge="1" parent="1" source="ecs-a" target="apigw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 4. API Gateway -> Lambda -->
        <mxCell id="e7" value="④ 起動" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#E7157B;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;" edge="1" parent="1" source="apigw" target="lambda">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 5. Lambda -> Translate -->
        <mxCell id="e8" value="⑤ 翻訳要求" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#01A88D;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;" edge="1" parent="1" source="lambda" target="translate">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 5. Translate -> Comprehend -->
        <mxCell id="e9" value="⑤ 言語自動判定" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#01A88D;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;dashed=1;" edge="1" parent="1" source="translate" target="comprehend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 6. Lambda -> ALB(a) Incoming Webhook -->
        <mxCell id="e10" value="⑥ Incoming Webhook（ALB経由で翻訳文を投稿）" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#8C4FFF;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;" edge="1" parent="1" source="lambda" target="alb-a">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="710" y="380" />
            </Array>
          </mxGeometry>
        </mxCell>
        <!-- 7. Lambda -> Secrets Manager -->
        <mxCell id="e11" value="⑦ トークン取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#DD344C;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;" edge="1" parent="1" source="lambda" target="secrets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <!-- 7. ECS(a) -> Secrets Manager -->
        <mxCell id="e12" value="⑦ DB認証情報取得" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#DD344C;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=11;dashed=1;" edge="1" parent="1" source="ecs-a" target="secrets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- 凡例 -->
        <mxCell id="legend-title" value="データフロー凡例" style="text;html=1;strokeColor=#232F3E;fillColor=#F2F3F3;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=12;fontStyle=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="260" height="200" as="geometry" />
        </mxCell>
        <mxCell id="legend-body" value="① 参加者 → Internet → ALB → ECS(Mattermost)&#10;② ECS ⇄ Aurora Serverless v2（読み書き）&#10;③ ECS → S3（ファイル保存・任意）&#10;④ Mattermost Outgoing Webhook → API GW → Lambda&#10;⑤ Lambda → Translate（→ Comprehend 言語判定）&#10;⑥ Lambda → ALB経由 → Mattermost Incoming Webhook&#10;⑦ Lambda / ECS → Secrets Manager（認証情報取得）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontColor=#232F3E;fontFamily=M PLUS 1;fontSize=10;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="68" y="648" width="248" height="168" as="geometry" />
        </mxCell>

